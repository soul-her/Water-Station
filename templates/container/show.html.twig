{% extends 'base.html.twig' %}

{% block title %}Container{% endblock %}

{% block body %}
    <h1>Container</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ container.id }}</td>
            </tr>
            <tr>
                <th>User_id</th>
                <td>{{ container.userId }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ container.status }}</td>
            </tr>
            <tr>
                <th>Pickup_time</th>
                <td>{{ container.pickupTime ? container.pickupTime|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Delivered_at</th>
                <td>{{ container.deliveredAt ? container.deliveredAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_container_index') }}">back to list</a>

    <a href="{{ path('app_container_edit', {'id': container.id}) }}">edit</a>

    {{ include('container/_delete_form.html.twig') }}
{% endblock %}
