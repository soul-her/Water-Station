{% extends 'base.html.twig' %}

{% block title %}Container index{% endblock %}

{% block body %}
    <h1>Container index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>User_id</th>
                <th>Status</th>
                <th>Pickup_time</th>
                <th>Delivered_at</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for container in containers %}
            <tr>
                <td>{{ container.id }}</td>
                <td>{{ container.userId }}</td>
                <td>{{ container.status }}</td>
                <td>{{ container.pickupTime ? container.pickupTime|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ container.deliveredAt ? container.deliveredAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_container_show', {'id': container.id}) }}">show</a>
                    <a href="{{ path('app_container_edit', {'id': container.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_container_new') }}">Create new</a>
{% endblock %}
