<!-- Backdrop -->
<div id="cart-backdrop" class="fixed inset-0 bg-black bg-opacity-50 hidden backdrop z-40" onclick="closeCartSidebar()"></div>

<!-- Cart Sidebar -->
<div id="cart-sidebar" class="fixed top-0 right-0 h-full bg-white shadow-2xl z-50 p-6 overflow-y-auto">
    <h2 class="text-2xl font-bold mb-6 text-center">🛒 Your Cart</h2>

    <div id="cart-items" class="space-y-4">
        <!-- JS will insert cart items here -->
    </div>

    <hr class="my-4">
    <p class="text-right text-lg font-semibold">
        Total: ₱<span id="cart-total">0.00</span>
    </p>

    <div class="mt-6 flex justify-between">
        <button onclick="clearCart()" class="bg-gray-300 hover:bg-gray-400 px-4 py-2 rounded-lg">
            Clear
        </button>
        <button id="checkout-btn" 
            class="primary-accent hover:bg-[#0099D0] text-white px-6 py-2 rounded-lg font-semibold">
            Checkout
        </button>
    </div>
</div>
