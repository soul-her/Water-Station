<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin Dashboard{% endblock %} | Touch Up</title>

    <!-- ✅ Manual TailwindCSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- ✅ Optional custom CSS file -->
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}">

    <!-- ✅ DataTables with Tailwind theme -->
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.tailwindcss.css">

    <style>
        /* Tabs styling */
        .nav-tabs .nav-link {
            display: inline-block;
            padding: 0.5rem 1rem;
            font-size: 0.875rem;
            font-weight: 500;
            color: #6b7280; /* text-gray-500 */
            border-bottom: 2px solid transparent;
            transition: all 0.2s ease;
        }

        .nav-tabs .nav-link:hover {
            color: #374151; /* hover:text-gray-700 */
            border-color: #d1d5db; /* hover:border-gray-300 */
        }

        .nav-tabs .nav-link.active {
            color: #2563eb; /* text-blue-600 */
            border-color: #2563eb; /* border-blue-600 */
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>

<body class="min-h-screen bg-gray-100">
    <!-- ✅ Flash Messages -->
    <div class="max-w-7xl mx-auto mt-6 px-4 sm:px-6 lg:px-8">
        {% for message in app.flashes('success') %}
            <div class="bg-green-50 border-l-4 border-green-500 text-green-700 p-4 mb-4 rounded-md shadow-sm" role="alert">
                <p class="font-semibold">✅ Success:</p>
                <p>{{ message }}</p>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 mb-4 rounded-md shadow-sm" role="alert">
                <p class="font-semibold">❌ Error:</p>
                <p>{{ message }}</p>
            </div>
        {% endfor %}
    </div>

    <!-- ✅ Main Content Area -->
    <main class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center mb-8">
            <h1 class="text-3xl font-bold text-gray-900">{% block title %}Admin Dashboard{% endblock %}</h1>
            <a href="{{ path('app_logout') }}" class="text-sm font-medium text-blue-600 hover:text-blue-800 transition">Logout</a>
        </div>

        <!-- ✅ Tab Navigation -->
        <div class="border-b border-gray-200">
            <nav class="-mb-px flex flex-wrap gap-4 nav-tabs" aria-label="Tabs">
                {% set active_tab = app.request.query.get('tab', 'orders') %}

                <a href="{{ path('app_admin_dashboard', {'tab': 'orders'}) }}" 
                   class="nav-link {% if active_tab == 'orders' %}active{% endif %}">
                    📦 Orders
                </a>

                <a href="{{ path('app_admin_dashboard', {'tab': 'products'}) }}" 
                   class="nav-link {% if active_tab == 'products' %}active{% endif %}">
                    🧴 Products
                </a>

                <a href="{{ path('app_admin_dashboard', {'tab': 'stock'}) }}" 
                   class="nav-link {% if active_tab == 'stock' %}active{% endif %}">
                    📊 Stock
                </a>

                <a href="{{ path('app_admin_dashboard', {'tab': 'categories'}) }}" 
                   class="nav-link {% if active_tab == 'categories' %}active{% endif %}">
                    🗂️ Categories
                </a>
            </nav>
        </div>

        <!-- ✅ Dashboard Content Block -->
        <section class="mt-8 bg-white shadow-xl rounded-xl p-6 lg:p-8">
            {% block dashboard_content %}
            <p class="text-gray-500 text-center">Select a tab above to manage admin content.</p>
            {% endblock %}
        </section>
    </main>

    <!-- ✅ JS Libraries -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" 
            integrity="sha256-/JqT3SQfawR/Y2/232m/N/A6kzX24B51jW53/3yA6Wq0=" 
            crossorigin="anonymous"></script>

    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.tailwindcss.js"></script>

    <!-- ✅ Optional Custom JS -->
    <script src="{{ asset('js/admin.js') }}"></script>

    {% block javascripts %}{% endblock %}
</body>
</html>
