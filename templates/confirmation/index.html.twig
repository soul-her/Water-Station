{% extends 'base.html.twig' %}

{% block body %}
<div class="max-w-xl mx-auto mt-16 bg-white p-8 rounded-xl shadow-lg text-center">
    <h1 class="text-3xl font-bold text-blue-600 mb-4">🎉 Order Confirmed!</h1>

    <p class="text-gray-700 mb-6">
        Thank you, <strong>{{ order.name }}</strong>!  
        Your order has been placed successfully.
    </p>

    <div class="text-left border-t border-gray-200 pt-4">
        <p><strong>Address:</strong> {{ order.address }}</p>
        <p><strong>Contact:</strong> {{ order.contact }}</p>
        <p><strong>Status:</strong> {{ order.status }}</p>
        <p><strong>Order Date:</strong> {{ order.createdAt|date('F j, Y g:i A') }}</p>
    </div>

    <a href="{{ path('dashboard_index') }}"
       class="inline-block mt-8 bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg transition">
        🏠 Return to Home
    </a>
</div>
{% endblock %}
