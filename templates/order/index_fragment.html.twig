{# templates/order/index_fragment.html.twig #}

<div class="flex justify-between items-center mb-6">
    <h2 class="text-2xl font-semibold text-gray-800">Orders</h2>
    <a href="{{ path('app_order_new') }}"
       class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg shadow transition duration-150 ease-in-out">
        ➕ Create New Order
    </a>
</div>

<div class="overflow-x-auto">
    <table id="ordersTable" class="min-w-full text-sm text-gray-700 divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="py-3 px-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                <th class="py-3 px-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                <th class="py-3 px-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Contact</th>
                <th class="py-3 px-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Address</th>
                <th class="py-3 px-4 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th class="py-3 px-4 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created At</th>
                <th class="py-3 px-4 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
        </thead>

        <tbody class="bg-white divide-y divide-gray-200">
            {% for order in orders %}
                <tr class="hover:bg-gray-50 transition duration-100">
                    <td class="px-4 py-3 text-gray-900">{{ order.id }}</td>
                    <td class="px-4 py-3 text-gray-700">{{ order.name }}</td>
                    <td class="px-4 py-3 text-gray-700">{{ order.contact }}</td>
                    <td class="px-4 py-3 text-gray-700">{{ order.address }}</td>
                    <td class="px-4 py-3 text-center">
                        <span class="px-3 inline-flex text-xs font-semibold rounded-full
                            {% if order.status == 'Pending' %}bg-yellow-100 text-yellow-800
                            {% elseif order.status == 'Delivered' %}bg-green-100 text-green-800
                            {% elseif order.status == 'Cancelled' %}bg-red-100 text-red-800
                            {% else %}bg-blue-100 text-blue-800{% endif %}">
                            {{ order.status }}
                        </span>
                    </td>
                    <td class="px-4 py-3 text-gray-700">{{ order.createdAt|date('Y-m-d H:i') }}</td>
                    <td class="px-4 py-3 text-center space-x-2">
                        <a href="{{ path('app_order_show', {'id': order.id}) }}" class="text-blue-600 hover:text-blue-900 font-medium">Show</a>
                        {% if order.status == 'Pending' %}
                            <a href="{{ path('app_order_edit', {'id': order.id}) }}" class="text-indigo-600 hover:text-indigo-900 font-medium">Edit</a>
                            <form method="post" action="{{ path('app_order_cancel', {'id': order.id}) }}" class="inline-block" onsubmit="return confirm('Cancel order #{{ order.id }}?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ order.id) }}">
                                <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-2 py-1 text-xs rounded-lg shadow">Cancel</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="text-center py-8 text-gray-400 italic">No orders available yet.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<style>
/* ✅ Consistent Tailwind styling for DataTables elements */
.dataTables_filter input {
  background-color: white !important;
  color: #1f2937 !important;
  border: 1px solid #d1d5db !important;
  border-radius: 0.5rem !important;
  padding: 0.5rem 1rem !important;
  outline: none !important;
}
.dataTables_filter input:focus {
  box-shadow: 0 0 0 2px #2563eb33 !important;
}
.dataTables_wrapper .dataTables_length select {
  background-color: white !important;
  border: 1px solid #d1d5db !important;
  border-radius: 0.5rem !important;
  padding: 0.25rem 0.5rem !important;
}
.dataTables_wrapper .dataTables_paginate a {
  background-color: white;
  border: 1px solid #e5e7eb;
  border-radius: 0.375rem;
  padding: 0.25rem 0.5rem;
  margin: 0 0.125rem;
}
.dataTables_wrapper .dataTables_paginate a.current {
  background-color: #2563eb;
  color: white !important;
  border-color: #2563eb;
}
</style>

<script>
(function() {
  const JQ = 'https://code.jquery.com/jquery-3.7.1.min.js';
  const DT_JS = 'https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js';
  const DT_CSS = 'https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css';

  function loadScript(src) {
    return new Promise((resolve, reject) => {
      if (document.querySelector(`script[src="${src}"]`)) return resolve();
      const s = document.createElement('script');
      s.src = src;
      s.onload = resolve;
      s.onerror = reject;
      document.head.appendChild(s);
    });
  }

  function loadCss(href) {
    return new Promise((resolve, reject) => {
      if (document.querySelector(`link[href="${href}"]`)) return resolve();
      const l = document.createElement('link');
      l.rel = 'stylesheet';
      l.href = href;
      l.onload = resolve;
      l.onerror = reject;
      document.head.appendChild(l);
    });
  }

  async function initOrdersTable() {
    await loadCss(DT_CSS);
    if (typeof window.jQuery === 'undefined') await loadScript(JQ);
    const $ = window.jQuery;
    if (!$.fn.DataTable) await loadScript(DT_JS);

    if ($.fn.DataTable.isDataTable('#ordersTable')) {
      $('#ordersTable').DataTable().destroy();
    }

    $('#ordersTable').DataTable({
      responsive: true,
      order: [[0, 'desc']], // show newest first
      columnDefs: [{ targets: 6, orderable: false, searchable: false }],
      language: {
        search: "",
        searchPlaceholder: "🔍 Search orders...",
        paginate: { previous: "← Prev", next: "Next →" }
      },
      pageLength: 10,
      initComplete: function() {
        const wrapper = $(this.api().table().container());
        const dtInput = wrapper.find('div.dataTables_filter input');
        dtInput.addClass(
          'bg-white text-gray-900 border border-gray-300 rounded-lg px-3 py-2 focus:outline-none ' +
          'focus:ring-2 focus:ring-blue-500 focus:border-blue-500 shadow-sm'
        ).attr('placeholder', '🔍 Search orders...');
        wrapper.find('.dataTables_filter').addClass('float-right mb-3');
      }
    });
  }

  initOrdersTable();
})();
</script>
