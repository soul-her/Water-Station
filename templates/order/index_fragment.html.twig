{# templates/order/index_fragment.html.twig #}
{# This template is designed to be embedded (rendered) within the Admin Dashboard #}

<div class="p-0">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-semibold text-gray-800">Orders</h2>
        <a href="{{ path('order_new') }}" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-4 rounded-lg shadow-md transition duration-150 ease-in-out">
            Create New Order
        </a>
    </div>

    <div class="overflow-x-auto">
        <table id="ordersTable" class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                    <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                    <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Contact</th>
                    <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Address</th>
                    <th scope="col" class="px-3 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                    <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created At</th>
                    <th scope="col" class="px-3 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
            {% for order in orders %}
                <tr class="hover:bg-gray-50">
                    <td class="px-3 py-3 whitespace-nowrap text-sm font-medium text-gray-900">{{ order.id }}</td>
                    <td class="px-3 py-3 whitespace-nowrap text-sm text-gray-700">{{ order.name }}</td>
                    <td class="px-3 py-3 whitespace-nowrap text-sm text-gray-700">{{ order.contact }}</td>
                    <td class="px-3 py-3 whitespace-nowrap text-sm text-gray-700 max-w-xs overflow-hidden text-ellipsis">{{ order.address }}</td>
                    <td class="px-3 py-3 whitespace-nowrap text-sm text-center">
                        <span class="px-3 inline-flex text-xs leading-5 font-semibold rounded-full
                            {% if order.status == 'Pending' %}bg-yellow-100 text-yellow-800
                            {% elseif order.status == 'Delivered' %}bg-green-100 text-green-800
                            {% elseif order.status == 'Cancelled' %}bg-red-100 text-red-800
                            {% else %}bg-blue-100 text-blue-800{% endif %}">
                            {{ order.status }}
                        </span>
                    </td>
                    <td class="px-3 py-3 whitespace-nowrap text-sm text-gray-700">{{ order.createdAt|date('Y-m-d H:i') }}</td>
                    
                    <td class="px-3 py-3 whitespace-nowrap text-sm text-center space-x-2">
                        <a href="{{ path('order_show', {id: order.id}) }}" class="text-blue-600 hover:text-blue-900 font-medium">Show</a>
                        
                        {% if order.status == 'Pending' %}
                            <a href="{{ path('order_edit', {id: order.id}) }}" class="text-indigo-600 hover:text-indigo-900 font-medium">Edit</a>
                            
                            <form method="post" action="{{ path('order_cancel', {id: order.id}) }}" class="inline-block" onsubmit="return confirm('Are you sure you want to cancel Order #{{ order.id }}?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ order.id) }}">
                                <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-2 py-1 text-xs font-semibold rounded-lg shadow transition duration-150 ease-in-out">Cancel</button>
                            </form>
                            
                            {% include 'order/_delete_form.html.twig' %}
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="px-6 py-4 text-center text-gray-500">No orders found.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<script>
    // Ensure the DataTables initialization is wrapped in a check and destroys old instance if needed
    $(document).ready(function() {
        // Destroy existing DataTables instance if it somehow survived (important in AJAX-like contexts)
        if ($.fn.DataTable.isDataTable('#ordersTable')) {
            $('#ordersTable').DataTable().destroy();
        }
        
        // Initialize DataTables on the target table ID
        $('#ordersTable').DataTable({
            responsive: true,
            order: [[5, 'desc']], // Sort by 'Created At' column by default (column index 5)
            columnDefs: [
                { targets: 6, orderable: false, searchable: false } // Disable sorting/searching on the 'Actions' column
            ],
            // Customize pagination text for a cleaner look
            language: {
                paginate: {
                    previous: 'Prev',
                    next: 'Next'
                }
            }
        });
    });
</script>