<form method="post" action="{{ path('order_delete', {'id': order.id}) }}" class="inline-block" onsubmit="return confirm('Are you sure you want to permanently delete this order? This cannot be undone.');">
<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ order.id) }}">
<button class="text-sm font-medium text-red-600 hover:text-red-800 hover:bg-red-50 px-2 py-1 rounded-md transition duration-150">Delete</button>
</form>