{% extends 'base.html.twig' %}

{% block body %}
<header>
    <h1>Touch Up</h1>
    <nav>
        <a href="{{ path('dashboard') }}">Home</a>
        <a href="{{ path('cart_index') }}">Cart 🛒</a>
    </nav>
</header>

<section class="hero">
    <h2>Pure Water Delivered</h2>
    <p>Seamless water delivery for a healthy and hydrated life.</p>
</section>

<section class="products">
    <h3>Our Products</h3>
    <div class="product-grid">
        {% for product in products %}
            <div class="product-card">
                <h4>{{ product.name }}</h4>
                <p>{{ product.description }}</p>
                <p><strong>₱{{ product.price|number_format(2) }}</strong></p>

                {% if product.name == 'Empty Container Pickup' %}
                    <a href="#" class="btn btn-green">Schedule</a>
                {% else %}
                    <a href="{{ path('cart_add', {'id': product.id}) }}" class="btn btn-blue">Add to Cart</a>
                {% endif %}
            </div>
        {% endfor %}
    </div>
</section>

<style>
/* --- General Layout --- */
body {
    font-family: Arial, sans-serif;
    background: #f8fafc;
    color: #333;
    margin: 0;
    padding: 0;
}

/* --- Header --- */
header {
    background: white;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}
header h1 {
    font-size: 1.5rem;
    color: #111;
}
nav a {
    color: #0056d2;
    text-decoration: none;
    font-weight: 600;
    margin-left: 1rem;
}
nav a:hover {
    text-decoration: underline;
}

/* --- Hero Section --- */
.hero {
    background: linear-gradient(90deg, #004aad, #0078ff);
    color: white;
    text-align: center;
    padding: 3rem 1rem;
    border-radius: 0 0 1.5rem 1.5rem;
}
.hero h2 {
    font-size: 2.2rem;
    margin-bottom: 0.5rem;
}
.hero p {
    font-size: 1.1rem;
}

/* --- Products Section --- */
.products {
    padding: 2rem;
    text-align: center;
}
.product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    margin-top: 1rem;
}
.product-card {
    background: white;
    border-radius: 1rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    padding: 1rem;
    transition: transform 0.2s ease;
}
.product-card:hover {
    transform: translateY(-5px);
}

/* --- Buttons --- */
.btn {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    border-radius: 0.6rem;
    text-decoration: none;
    color: white;
    font-weight: 600;
    margin-top: 0.5rem;
}
.btn-blue {
    background: #0056d2;
}
.btn-blue:hover {
    background: #003c9d;
}
.btn-green {
    background: #28a745;
}
.btn-green:hover {
    background: #1e7e34;
}
</style>
{% endblock %}
