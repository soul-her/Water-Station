{% extends 'base.html.twig' %}

{% block title %}Dashboard - Touch Up{% endblock %}

{% block body %}
<!-- Hero Section -->

<section id="hero"
    class="relative bg-cover bg-center text-white py-20 md:py-32" 
    style="background-image: url('/images/water-bg.jpg');">
    
    <!-- Overlay Gradient -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#003366]/90 to-[#00A8E8]/70"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
        <p class="text-xl font-semibold mb-3 text-white">REVOLUTIONIZING WATER DELIVERY</p>
        <h2 class="text-5xl md:text-7xl font-extrabold mb-6 leading-tight drop-shadow-lg">
            <span class="text-yellow-300">Pure.</span> Delivered. Effortless.
        </h2>
        <a href="#products" class="px-10 py-4 bg-white text-[#00A8E8] font-bold rounded-full text-lg transition duration-300 shadow-xl hover:bg-gray-100 hover:scale-[1.02]">
            See Pricing & Order Now
        </a>
    </div>
</section>


<!-- Products Section -->
<section id="products" class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h3 class="text-4xl font-extrabold primary-dark text-center mb-16">Choose Your Hydration Solution</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {% for product in products %}
                <div class="bg-white p-6 rounded-2xl shadow-lg card-lift flex flex-col items-center text-center border-t-4 border-blue-500">
                    <div class="w-20 h-20 flex items-center justify-center bg-blue-50 rounded-full mb-6">
                        <img src="{{ asset('uploads/products/' ~ product.image) }}" alt="{{ product.name }}" class="w-16 h-16 object-contain">
                    </div>
                    <h4 class="text-2xl font-bold primary-dark">{{ product.name }}</h4>
                    <p class="text-gray-500 my-4">{{ product.description ?: '' }}</p>
                    <p class="text-4xl font-extrabold primary-accent-text mb-6">₱{{ product.price }}<span class="text-xl text-gray-400">/unit</span></p>
                    <button data-id="{{ product.id }}" data-name="{{ product.name }}" data-price="{{ product.price }}" class="add-to-cart-btn w-full py-3 primary-accent text-white font-semibold rounded-full primary-accent-hover shadow-md">
                        Add to Cart
                    </button>
                </div>
            {% else %}
                <p class="text-center text-gray-500 col-span-3">No products available.</p>
            {% endfor %}
        </div>
    </div>
</section>

<!-- How It Works Section -->
<section class="bg-white py-16 md:py-24 border-t">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h3 class="text-4xl font-extrabold primary-dark text-center mb-12">How It Works</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
            <div class="text-center p-6 border-2 border-gray-100 rounded-xl">
                <span class="text-5xl font-extrabold primary-accent-text mb-3 block">1</span>
                <h4 class="text-xl font-bold primary-dark mb-2">Order Online</h4>
                <p class="text-gray-600">Choose your product (refill or new gallon) from our selection above.</p>
            </div>
            <div class="text-center p-6 border-2 border-gray-100 rounded-xl">
                <span class="text-5xl font-extrabold primary-accent-text mb-3 block">2</span>
                <h4 class="text-xl font-bold primary-dark mb-2">We Prepare</h4>
                <p class="text-gray-600">Our team sanitizes, fills, and seals your pure drinking water.</p>
            </div>
            <div class="text-center p-6 border-2 border-gray-100 rounded-xl">
                <span class="text-5xl font-extrabold primary-accent-text mb-3 block">3</span>
                <h4 class="text-xl font-bold primary-dark mb-2">Fast Delivery</h4>
                <p class="text-gray-600">Your order is delivered right to your location, fast and safely.</p>
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block scripts %}
<!-- Add your JS cart logic here -->
{% endblock %}
