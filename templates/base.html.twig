{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Water Station Delivery{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-white text-gray-800">

    <!-- Header -->
    <header class="bg-white shadow-sm sticky top-0 z-50">
        <div class="container mx-auto px-4 py-4 flex items-center justify-between">
            <a href="#" class="font-bold text-xl text-blue-600">About Us</a>
            
            <!-- Desktop Menu -->
            <nav class="hidden md:flex space-x-6">
                <a href="#products" class="text-gray-600 hover:text-blue-600 transition-colors duration-200">Products</a>
                <a href="#" class="text-gray-600 hover:text-blue-600 transition-colors duration-200">Contact</a>
                <a href="#" class="text-gray-600 hover:text-blue-600 transition-colors duration-200">FAQ</a>
            </nav>

            <!-- Cart + Mobile Menu -->
            <div class="flex items-center space-x-4">
                <a href="#" class="text-gray-600 hover:text-blue-600 transition-colors duration-200">
                    🛒
                </a>
                <button id="mobile-menu-btn" class="md:hidden text-gray-600 hover:text-blue-600 transition-colors duration-200">
                    ☰
                </button>
            </div>
        </div>
        
        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden md:hidden bg-gray-50 border-t border-gray-200 py-2">
            <nav class="flex flex-col items-center space-y-2">
                <a href="#products" class="block w-full text-center py-2 text-gray-600 hover:bg-gray-100 transition-colors duration-200">Products</a>
                <a href="#" class="block w-full text-center py-2 text-gray-600 hover:bg-gray-100 transition-colors duration-200">Contact</a>
                <a href="#" class="block w-full text-center py-2 text-gray-600 hover:bg-gray-100 transition-colors duration-200">FAQ</a>
            </nav>
        </div>
    </header>

    <!-- Page Content -->
    <main>
        {% block body %}{% endblock %}
    </main>

    <!-- Footer -->
    <footer class="bg-gray-900 text-gray-300 py-8 px-4 text-center">
        <div class="container mx-auto">
            <p>&copy; {{ "now"|date("Y") }} Water Station Delivery. All Rights Reserved.</p>
        </div>
    </footer>

    <script>
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        if(mobileMenuBtn){
            mobileMenuBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });
        }
    </script>
</body>
</html>
