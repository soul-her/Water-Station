<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Touch Up - Pure Water Delivery{% endblock %}</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; overflow-x: hidden; }
        .primary-dark { color: #003366; }
        .primary-accent { background-color: #00A8E8; }
        .primary-accent-text { color: #00A8E8; }
        .primary-accent-hover:hover { background-color: #0099D0; }
        .card-lift { transition: transform 0.3s ease, box-shadow 0.3s ease; }
        .card-lift:hover { transform: translateY(-8px); box-shadow: 0 15px 25px -5px rgba(0,50,100,0.15); }
    </style>

    {% block styles %}{% endblock %}
</head>
<body>
    <!-- Header -->
    <header class="bg-white sticky top-0 z-30 border-b border-gray-100 shadow-md">
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
            <!-- LOGO AND TITLE WRAPPER -->
            <div class="flex items-center space-x-3">
                <h1 class="text-3xl font-extrabold text-blue-600">TOUCH UP</h1>
                <!-- Correct path to public/images/logo-placeholder.png -->
                <img src="{{ asset('images/logo-placeholder.png') }}" alt="Touch Up Logo" class="h-10 w-auto object-contain">
            </div>

            <nav class="hidden md:flex items-center space-x-8">
                <a href="{{ path('dashboard_index') }}" class="text-gray-600 font-medium hover:text-blue-600 transition">Home</a>
                <a href="#products" class="text-gray-600 font-medium hover:text-blue-600 transition">Pricing</a>
                <a href="#How" class="text-gray-600 font-medium hover:text-blue-600 transition">How it Works</a>
            </nav>

            <!-- 🛒 Cart Button -->
            <a href="{{ path('cart_index') }}" class="relative flex items-center space-x-1">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
                <span id="cart-count"
                      class="absolute -top-2 -right-2 bg-red-600 text-white text-xs rounded-full px-1.5">
                    {{ app.session.get('cart') is defined ? app.session.get('cart')|length : 0 }}
                </span>
            </a>
        </div>
    </header>

    <!-- Main Content -->
    <main class="min-h-screen">
        {% block body %}{% endblock %}
    </main>

    <!-- Footer -->
    <footer class="bg-gray-900 text-white text-center py-6 mt-10">
        <p>&copy; {{ "now"|date("Y") }} Touch Up Water Delivery.</p>
    </footer>

    <!-- Scripts -->
    <script src="{{ asset('js/cart.js') }}"></script>
    {% block scripts %}{% endblock %}
</body>
</html>
