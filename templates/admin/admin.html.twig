<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | Touch Up</title>

    <script src="https://cdn.tailwindcss.com"></script>
  
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.tailwindcss.css">
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}">
    <style>
        /* Sidebar Links */
        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
            font-weight: 500;
            color: #374151;
            transition: all 0.2s ease;
        }
        .sidebar-link:hover {
            background-color: #e5e7eb;
            color: #1d4ed8;
        }
        .sidebar-link.active {
            background-color: #2563eb;
            color: white;
        }

        /* Fixed Sidebar */
        .sidebar-fixed {
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            overflow-y: auto;
            z-index: 50;
        }

        /* Sidebar Scrollbar */
        .sidebar-fixed::-webkit-scrollbar {
            width: 8px;
        }
        .sidebar-fixed::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
    </style>
</head>

<body class="bg-gray-100 flex">
    {% set active_tab = app.request.query.get('tab', 'orders') %}

    <!-- ✅ Sidebar -->
    <aside class="sidebar-fixed w-64 bg-white border-r border-gray-200 shadow-md flex flex-col">
        <div class="px-6 py-6 border-b border-gray-200 sticky top-0 bg-white z-10">
            <h1 class="text-2xl font-bold text-gray-800">Touch Up Admin</h1>
        </div>

        <nav class="flex-1 px-4 py-6 space-y-2">
            <a href="{{ path('app_admin_dashboard', {'tab': 'orders'}) }}" 
               class="sidebar-link {% if active_tab == 'orders' %}active{% endif %}">
                📦 Orders
            </a>
            <a href="{{ path('app_admin_dashboard', {'tab': 'products'}) }}" 
               class="sidebar-link {% if active_tab == 'products' %}active{% endif %}">
                🧴 Products
            </a>
            <a href="{{ path('app_admin_dashboard', {'tab': 'stock'}) }}" 
               class="sidebar-link {% if active_tab == 'stock' %}active{% endif %}">
                📊 Stock
            </a>
            <a href="{{ path('app_admin_dashboard', {'tab': 'categories'}) }}" 
               class="sidebar-link {% if active_tab == 'categories' %}active{% endif %}">
                🗂️ Categories
            </a>
        </nav>
    </aside>

    <!-- ✅ Main Content -->
    <div class="flex-1 ml-64 flex flex-col min-h-screen">
        

        <!-- Flash Messages -->
        <div class="max-w-4xl mx-auto mt-6 px-6 w-full">
            {% for message in app.flashes('success') %}
                <div class="bg-green-50 border-l-4 border-green-500 text-green-700 p-4 mb-4 rounded-md shadow-sm">
                    <p class="font-semibold">✅ Success:</p>
                    <p>{{ message }}</p>
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 mb-4 rounded-md shadow-sm">
                    <p class="font-semibold">❌ Error:</p>
                    <p>{{ message }}</p>
                </div>
            {% endfor %}
        </div>

        <!-- Main Panel -->
        <main class="flex-1 flex justify-center py-10 px-8 bg-gray-50 overflow-y-auto">
            <section class="bg-white shadow-xl rounded-xl p-10 w-full max-w-5xl">
                {% if active_tab == 'orders' %}
                    {{ render(controller('App\\Controller\\OrderController::index')) }}
                {% elseif active_tab == 'products' %}
                    {{ render(controller('App\\Controller\\ProductController::index')) }}
                {% elseif active_tab == 'stock' %}
                    {{ render(controller('App\\Controller\\StockController::index')) }}
                {% elseif active_tab == 'categories' %}
                    {{ render(controller('App\\Controller\\CategoryController::index')) }}
                {% else %}
                    <p class="text-gray-500 text-center">Select a section from the sidebar to view management panels.</p>
                {% endif %}
            </section>
        </main>
    </div>

    <!-- ✅ Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.tailwindcss.js"></script>
    <script src="{{ asset('js/admin.js') }}"></script>
</body>
</html>
