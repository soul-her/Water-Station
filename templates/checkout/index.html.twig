{% extends 'base.html.twig' %}

{% block body %}
<div class="max-w-2xl mx-auto mt-10 bg-white p-8 rounded-xl shadow-lg">
    <h1 class="text-3xl font-bold text-center mb-6">Checkout</h1>

    {% for message in app.flashes('error') %}
        <div class="bg-red-100 text-red-700 px-4 py-2 mb-4 rounded-lg">
            {{ message }}
        </div>
    {% endfor %}

    {% if cart is not empty %}
        <div class="mb-6">
            <h2 class="text-xl font-semibold mb-3">Your Cart</h2>
            <ul class="divide-y divide-gray-200">
                {% for id, item in cart %}
                    <li class="py-2 flex justify-between">
                        <span>{{ item.name }} (x{{ item.quantity }})</span>
                        <span>₱{{ (item.price * item.quantity)|number_format(2, '.', ',') }}</span>
                    </li>
                {% endfor %}
            </ul>
            <div class="text-right font-bold mt-3 text-lg">
                Total: ₱{{ total|number_format(2, '.', ',') }}
            </div>
        </div>
<form method="POST" action="{{ path('checkout_submit') }}">
    <div class="mb-4">
        <label class="block mb-2 font-medium">Full Name</label>
        <input type="text" name="name" required
               class="w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500" />
    </div>

    <div class="mb-4">
        <label class="block mb-2 font-medium">Address</label>
        <input type="text" name="address" required
               class="w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500" />
    </div>

    <div class="mb-6">
        <label class="block mb-2 font-medium">Contact Number</label>
        <input type="text"
               name="contact"
               required
               inputmode="numeric"
               pattern="[0-9]*"
               maxlength="11"
               title="Please enter digits only (e.g., 09123456789)"
               class="w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500"
               oninput="this.value = this.value.replace(/[^0-9]/g, '');" />
    </div>

    <button type="submit"
            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-lg transition">
        Confirm Order
    </button>
</form>

    {% else %}
        <p class="text-center text-gray-500 mt-6">Your cart is empty.</p>
        <div class="text-center mt-4">
            <a href="{{ path('dashboard_index') }}" class="text-blue-600 hover:underline">Return to Shop</a>
        </div>
    {% endif %}
</div>
{% endblock %}
