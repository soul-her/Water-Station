{% extends 'base.html.twig' %}

{% block title %}Checkout - Touch Up{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto py-16 px-6">
    <h1 class="text-4xl font-bold text-center mb-8">💧 Checkout</h1>

    <div class="bg-white rounded-xl shadow-lg p-8">
        <h2 class="text-2xl font-semibold mb-4">Order Summary</h2>

        <ul class="divide-y divide-gray-200 mb-6">
            {% for item in cart %}
                <li class="py-3 flex justify-between">
                    <span>{{ item.name }} (x{{ item.quantity }})</span>
                    <span>₱{{ item.price * item.quantity }}</span>
                </li>
            {% endfor %}
        </ul>

        <div class="flex justify-between font-bold text-lg border-t pt-3 mb-8">
            <span>Total:</span>
            <span class="text-blue-600">₱{{ total }}</span>
        </div>

        <form method="POST" action="{{ path('cart_checkout_process') }}">
            <div class="grid grid-cols-1 gap-4 mb-6">
                <input type="text" name="name" placeholder="Full Name" required class="border rounded-lg px-4 py-3">
                <input type="text" name="address" placeholder="Delivery Address" required class="border rounded-lg px-4 py-3">
                <input type="text" name="contact" placeholder="Contact Number" required class="border rounded-lg px-4 py-3">
            </div>

            <button type="submit" class="w-full bg-green-600 text-white py-3 rounded-lg font-semibold hover:bg-green-700">
                Confirm Order
            </button>
        </form>
    </div>
</div>
{% endblock %}
