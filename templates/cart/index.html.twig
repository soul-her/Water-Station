{% extends 'base.html.twig' %}

{% block title %}My Cart - Touch Up{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto py-16 px-6">
    <h1 class="text-4xl font-bold text-center mb-10">🛒 Your Cart</h1>

    {% if cart is empty %}
        <p class="text-center text-gray-500">Your cart is empty.</p>
        <div class="text-center mt-6">
            <a href="{{ path('dashboard') }}" class="bg-blue-600 text-white py-3 px-6 rounded-lg hover:bg-blue-700">Continue Shopping</a>
        </div>
    {% else %}
        <table class="w-full border-collapse mb-10">
            <thead>
                <tr class="bg-gray-100">
                    <th class="py-3 px-4 text-left">Product</th>
                    <th class="py-3 px-4 text-center">Qty</th>
                    <th class="py-3 px-4 text-right">Price</th>
                    <th class="py-3 px-4 text-right">Total</th>
                </tr>
            </thead>
            <tbody>
                {% for item in cart %}
                    <tr class="border-b">
                        <td class="py-3 px-4 flex items-center gap-4">
                            <img src="{{ asset('uploads/products/' ~ item.image) }}" class="w-12 h-12 rounded" alt="">
                            <span>{{ item.name }}</span>
                        </td>
                        <td class="py-3 px-4 text-center">{{ item.quantity }}</td>
                        <td class="py-3 px-4 text-right">₱{{ item.price }}</td>
                        <td class="py-3 px-4 text-right font-semibold">₱{{ item.price * item.quantity }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <div class="flex justify-between items-center border-t pt-4">
            <h3 class="text-xl font-bold">Total:</h3>
            <p class="text-2xl font-bold text-blue-600">₱{{ total }}</p>
        </div>

        <div class="mt-10 flex justify-end">
            <a href="{{ path('cart_checkout') }}" class="bg-green-600 text-white py-3 px-8 rounded-lg text-lg font-semibold hover:bg-green-700">
                Proceed to Checkout
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}
