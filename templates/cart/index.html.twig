{% extends 'base.html.twig' %}

{% block body %}
<div class="max-w-2xl mx-auto mt-10 bg-white p-8 rounded-xl shadow-lg">
    <h1 class="text-3xl font-bold text-center mb-6">Your Cart</h1>

    {% for message in app.flashes('success') %}
        <div class="bg-green-100 text-green-700 px-4 py-2 mb-4 rounded-lg">
            {{ message }}
        </div>
    {% endfor %}

    {% if cart is not empty %}
        <ul class="divide-y divide-gray-200">
            {% for id, item in cart %}
                <li class="py-3 flex justify-between items-center">
                    <div>
                        <span class="font-medium">{{ item.name }}</span>
                        <div class="flex items-center gap-2 mt-1">
                            <form method="POST" action="{{ path('cart_decrease', {'id': id}) }}">
                                <button type="submit" class="bg-gray-200 px-2 py-1 rounded hover:bg-gray-300">-</button>
                            </form>

                            <span class="mx-2 text-lg font-semibold">{{ item.quantity }}</span>

                            <form method="POST" action="{{ path('cart_increase', {'id': id}) }}">
                                <button type="submit" class="bg-gray-200 px-2 py-1 rounded hover:bg-gray-300">+</button>
                            </form>
                        </div>
                    </div>

                    <span class="font-semibold">₱{{ (item.price * item.quantity)|number_format(2, '.', ',') }}</span>
                </li>
            {% endfor %}
        </ul>

        <div class="text-right font-bold mt-3 text-lg">
            Total: ₱{{ total|number_format(2, '.', ',') }}
        </div>

        <div class="text-center mt-6">
            <a href="{{ path('checkout_index') }}" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700">Proceed to Checkout</a>
        </div>
    {% else %}
        <p class="text-center text-gray-500">Your cart is empty.</p>
    {% endif %}
</div>
{% endblock %}
