{% extends 'base.html.twig' %}
{% block title %}Order Confirmation{% endblock %}

{% block body %}
<div class="max-w-xl mx-auto bg-white p-8 rounded-2xl shadow-xl text-center mt-10">
    <h1 class="text-3xl font-bold text-green-600 mb-4">🎉 Order Confirmed!</h1>
    <p class="text-gray-600 mb-4">Thank you, {{ order.customerName }}! Your order has been successfully placed.</p>

    <p><strong>Delivery Address:</strong><br>
    {{ order.streetAddress }}, {{ order.barangay }}, {{ order.city }}</p>

    <p class="mt-4">Total Paid: <span class="text-2xl font-semibold">₱{{ order.total }}</span></p>

    <a href="{{ path('app_home') }}" class="mt-6 inline-block bg-blue-600 text-white py-2 px-6 rounded-lg hover:bg-blue-700">Return Home</a>
</div>
{% endblock %}
