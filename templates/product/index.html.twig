{% extends 'base.html.twig' %}

{% block body %}
<div class="max-w-5xl mx-auto p-8">
    <h1 class="text-3xl font-bold mb-6 text-center">📦 Product List</h1>

    <div class="mb-6 text-right">
        <a href="{{ path('app_product_new') }}" 
           class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition">
           ➕ Add Product
        </a>
    </div>

    <div class="overflow-x-auto shadow-lg rounded-lg">
        <table class="w-full text-sm text-left border-collapse">
            <thead class="bg-gray-100 text-gray-700 uppercase text-sm">
                <tr>
                    <th class="px-6 py-3">ID</th>
                    <th class="px-6 py-3">Name</th>
                    <th class="px-6 py-3">Stock</th>
                    <th class="px-6 py-3">Price</th>
                    <th class="px-6 py-3 text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for product in products %}
                    <tr class="border-b hover:bg-gray-50">
                        <td class="px-6 py-3">{{ product.id }}</td>
                        <td class="px-6 py-3 font-medium">{{ product.name }}</td>
                        <td class="px-6 py-3">{{ product.stock }}</td>
                        <td class="px-6 py-3">₱{{ product.price|number_format(2, '.', ',') }}</td>
                        <td class="px-6 py-3 text-center space-x-2">
                            <a href="{{ path('app_product_show', {'id': product.id}) }}" 
                               class="px-3 py-1 bg-blue-500 text-white rounded hover:bg-blue-600">👁 View</a>
                            <a href="{{ path('app_product_edit', {'id': product.id}) }}" 
                               class="px-3 py-1 bg-yellow-500 text-white rounded hover:bg-yellow-600">✏ Edit</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="px-6 py-3 text-center text-gray-500">No products found.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
