{% extends 'base.html.twig' %}

{% block title %}Edit Product{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto p-6 bg-white rounded-xl shadow-lg">
    <h1 class="text-2xl font-bold mb-4">Edit Product</h1>

    {{ form_start(form) }}
        {% if product.image %}
            <p>Current image:</p>
            <img src="{{ asset('uploads/products/' ~ product.image) }}" alt="{{ product.name }}" class="w-32 h-32 object-cover rounded mb-2">
        {% endif %}

        {{ form_widget(form) }}

        <div class="mt-4 flex gap-2">
            <button type="submit" class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700">Update</button>
            {% include 'product/_delete_form.html.twig' with {'product': product} %}
            <a href="{{ path('app_product_index') }}" class="px-4 py-2 bg-gray-400 text-white rounded hover:bg-gray-500">Back to List</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
