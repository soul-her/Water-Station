<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Product</title>

    {# ✅ Include Tailwind CSS via CDN #}
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center">

    <div class="max-w-2xl mx-auto p-6 bg-white rounded-xl shadow-lg w-full">
        <h1 class="text-2xl font-bold mb-4 text-gray-800">✏️ Edit Product</h1>

        {{ form_start(form) }}
            {% if product.image %}
                <p class="text-gray-700 mb-2 font-medium">Current Image:</p>
                <img src="{{ asset('uploads/products/' ~ product.image) }}" 
                     alt="{{ product.name }}" 
                     class="w-32 h-32 object-cover rounded mb-4 shadow">
            {% endif %}

            <div class="space-y-4">
                {{ form_widget(form, {'attr': {'class': 'space-y-3'}}) }}
            </div>

            <div class="mt-6 flex flex-wrap gap-3">
                <button type="submit" 
                        class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition">
                    Update
                </button>

                {% include 'product/_delete_form.html.twig' with {'product': product} %}

              
            </div>
        {{ form_end(form) }}
    </div>

</body>
</html>
