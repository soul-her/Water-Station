{{ form_start(form) }}
<div class="mb-4">
    {{ form_label(form.name, 'Product Name') }}
    {{ form_widget(form.name, {'attr': {'class': 'w-full border px-2 py-1 rounded'}}) }}
    {{ form_errors(form.name) }}
</div>

<div class="mb-4">
    {{ form_label(form.price, 'Price') }}
    {{ form_widget(form.price, {'attr': {'class': 'w-full border px-2 py-1 rounded'}}) }}
    {{ form_errors(form.price) }}
</div>

<div class="mb-4">
    {{ form_label(form.image, 'Product Image') }}
    {{ form_widget(form.image, {'attr': {'class': 'w-full'}}) }}
    {{ form_errors(form.image) }}
</div>

<button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
    {{ button_label|default('Save') }}
</button>
{{ form_end(form) }}

<a href="{{ path('app_product_index') }}" class="mt-4 inline-block text-gray-600 hover:underline">Back to list</a>
