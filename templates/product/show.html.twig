{% extends 'base.html.twig' %}

{% block body %}
<div class="max-w-md mx-auto p-8 bg-white rounded-xl shadow-lg">
    <h1 class="text-2xl font-bold mb-6 text-center">👁 Product Details</h1>

    <ul class="space-y-3">
        <li><span class="font-semibold">ID:</span> {{ product.id }}</li>
        <li><span class="font-semibold">Name:</span> {{ product.name }}</li>
        <li><span class="font-semibold">Stock:</span> {{ product.stock }}</li>
        <li><span class="font-semibold">Price:</span> ₱{{ product.price|number_format(2, '.', ',') }}</li>
    </ul>

    <div class="mt-6 flex justify-between">
        <a href="{{ path('app_product_index') }}" 
           class="px-4 py-2 bg-gray-300 text-gray-800 rounded hover:bg-gray-400">⬅ Back</a>
        <a href="{{ path('app_product_edit', {'id': product.id}) }}" 
           class="px-4 py-2 bg-yellow-500 text-white rounded hover:bg-yellow-600">✏ Edit</a>
    </div>

    <div class="mt-6 text-center">
        {{ include('product/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
