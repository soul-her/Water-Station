{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto p-6 bg-white rounded-xl shadow-lg">
    <h1 class="text-2xl font-bold mb-4">{{ product.name }}</h1>

    {% if product.image %}
        <img src="{{ asset('uploads/products/' ~ product.image) }}" alt="{{ product.name }}" class="w-full h-64 object-cover mb-4 rounded">
    {% endif %}

    <p class="font-semibold mb-4">₱{{ product.price|number_format(2) }}</p>

    <div class="flex gap-2">
        <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700">Edit</a>
        {% include 'product/_delete_form.html.twig' with {'product': product} %}
        <a href="{{ path('app_product_index') }}" class="px-4 py-2 bg-gray-400 text-white rounded hover:bg-gray-500">Back to List</a>
    </div>
</div>
{% endblock %}
