{% extends 'base.html.twig' %}

{% block title %}Add Product{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto p-6 bg-white rounded-xl shadow-lg">
    <h1 class="text-2xl font-bold mb-4">Add New Product</h1>

    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 mt-4">Save</button>
    {{ form_end(form) }}

    <a href="{{ path('app_product_index') }}" class="px-4 py-2 bg-gray-400 text-white rounded hover:bg-gray-500 mt-2 inline-block">Back to List</a>
</div>
{% endblock %}
