{% extends 'base.html.twig' %}

{% block body %}
<div class="max-w-md mx-auto p-8 bg-white rounded-xl shadow-lg">
    <h1 class="text-2xl font-bold mb-6 text-center">📝 Add New Product</h1>

    {{ form_start(form) }}
        <div class="mb-4">
            {{ form_label(form.name, 'Product Name', {'label_attr': {'class': 'block mb-2 font-medium'}}) }}
            {{ form_widget(form.name, {'attr': {'class': 'w-full p-2 border rounded focus:ring focus:ring-blue-300'}}) }}
            {{ form_errors(form.name) }}
        </div>

        <div class="mb-4">
            {{ form_label(form.stock, 'Stock', {'label_attr': {'class': 'block mb-2 font-medium'}}) }}
            {{ form_widget(form.stock, {'attr': {'class': 'w-full p-2 border rounded focus:ring focus:ring-blue-300'}}) }}
            {{ form_errors(form.stock) }}
        </div>

        <div class="mb-6">
            {{ form_label(form.price, 'Price (₱)', {'label_attr': {'class': 'block mb-2 font-medium'}}) }}
            {{ form_widget(form.price, {'attr': {'class': 'w-full p-2 border rounded focus:ring focus:ring-blue-300'}}) }}
            {{ form_errors(form.price) }}
        </div>

        <div class="flex justify-between">
            <a href="{{ path('app_product_index') }}" 
               class="px-4 py-2 bg-gray-300 text-gray-800 rounded hover:bg-gray-400">⬅ Back</a>
            <button type="submit" 
                    class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700">💾 Save</button>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
