{# templates/product/index_fragment.html.twig #}
{# Designed to be embedded (rendered) within the Admin Dashboard content block #}

<div class="p-0">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-semibold text-gray-800">Products</h2>

        <a href="{{ path('app_product_new') }}" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 font-medium transition duration-150 ease-in-out">
            ➕ Add New Product
        </a>
    </div>

    <div class="overflow-x-auto">
        {# NOTE: If you decide to add DataTables later, you will need to add an ID to this table and include the JS script at the end of this fragment. #}
        <table class="min-w-full divide-y divide-gray-200">
            <thead>
                <tr class="bg-gray-50">
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border">Image</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border">Name</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border">Price</th>
                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider border">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                {% for product in products %}
                <tr class="hover:bg-gray-50">
                    <td class="px-4 py-2 border">
                        {% if product.image %}
                            <img src="{{ asset('uploads/products/' ~ product.image) }}" alt="{{ product.name }}" class="w-16 h-16 object-cover rounded shadow">
                        {% else %}
                            <span class="text-gray-400 italic text-sm">No image</span>
                        {% endif %}
                    </td>
                    <td class="px-4 py-2 border font-medium text-gray-900">{{ product.name }}</td>
                    <td class="px-4 py-2 border text-gray-700 font-semibold">₱{{ product.price|number_format(2) }}</td>
                    <td class="px-4 py-2 border flex justify-center items-center gap-2 h-full">
                        <a href="{{ path('app_product_show', {'id': product.id}) }}" class="px-3 py-1 bg-gray-400 text-white rounded hover:bg-gray-500 text-sm">View</a>
                        <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="px-3 py-1 bg-green-600 text-white rounded hover:bg-green-700 text-sm">Edit</a>
                        {# The delete form must be included here #}
                        {% include 'product/_delete_form.html.twig' with {'product': product} %}
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="4" class="px-4 py-4 text-center text-gray-500 italic">No products found.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>