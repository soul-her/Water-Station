{# templates/stock/index_fragment.html.twig #}
<div class="flex justify-end mb-4">
    <a href="{{ path('app_stock_new') }}"
       class="bg-blue-600 text-white px-4 py-2 rounded-lg shadow-md hover:bg-blue-700 font-semibold transition duration-150">
        ➕ Add New Stock
    </a>
</div>

<div class="overflow-x-auto">
    <table id="stockTable" class="min-w-full text-sm text-gray-700 divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="py-3 px-6 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                <th class="py-3 px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Product</th>
                <th class="py-3 px-6 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Quantity</th>
                <th class="py-3 px-6 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            {% for stock in stocks %}
                <tr class="hover:bg-gray-50 transition duration-100">
                    <td class="py-4 px-6 text-center whitespace-nowrap">{{ stock.id }}</td>
                    <td class="py-4 px-6 font-medium text-gray-900 text-left whitespace-nowrap">
                        {{ stock.product ? stock.product.name : '—' }}
                    </td>
                    <td class="py-4 px-6 font-bold text-blue-600 text-right whitespace-nowrap">{{ stock.quantity }}</td>
                    <td class="py-4 px-6 text-right whitespace-nowrap space-x-3">
                        <a href="{{ path('app_stock_show', {'id': stock.id}) }}" class="text-blue-500 hover:text-blue-700">View</a>
                        <a href="{{ path('app_stock_edit', {'id': stock.id}) }}" class="text-green-600 hover:text-green-800">Edit</a>
                        <form method="post" action="{{ path('app_stock_delete', {'id': stock.id}) }}" class="inline-block"
                              onsubmit="return confirm('Are you sure you want to delete this stock?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ stock.id) }}">
                            <button class="text-red-500 hover:text-red-700" type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center py-8 text-gray-400 italic">No stock records available yet.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<style>
/* ✅ White search bar & Tailwind-friendly tweaks */
.dataTables_filter input {
  background-color: white !important;
  color: #1f2937 !important;
  border: 1px solid #d1d5db !important;
  border-radius: 0.5rem !important;
  padding: 0.5rem 1rem !important;
  outline: none !important;
}
.dataTables_filter input:focus {
  box-shadow: 0 0 0 2px #2563eb33 !important;
}
.dataTables_wrapper .dataTables_length select {
  background-color: white !important;
  border: 1px solid #d1d5db !important;
  border-radius: 0.5rem !important;
  padding: 0.25rem 0.5rem !important;
}
.dataTables_wrapper .dataTables_paginate a {
  background-color: white;
  border: 1px solid #e5e7eb;
  border-radius: 0.375rem;
  padding: 0.25rem 0.5rem;
  margin: 0 0.125rem;
}
.dataTables_wrapper .dataTables_paginate a.current {
  background-color: #2563eb;
  color: white !important;
  border-color: #2563eb;
}
</style>

<script>
(function() {
  const JQ = 'https://code.jquery.com/jquery-3.7.1.min.js';
  const DT_JS = 'https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js';
  const DT_CSS = 'https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css';

  // Utility to dynamically load scripts/styles
  function loadScript(src) {
    return new Promise((resolve, reject) => {
      if (document.querySelector(`script[src="${src}"]`)) return resolve();
      const s = document.createElement('script');
      s.src = src;
      s.onload = resolve;
      s.onerror = reject;
      document.head.appendChild(s);
    });
  }
  function loadCss(href) {
    return new Promise((resolve, reject) => {
      if (document.querySelector(`link[href="${href}"]`)) return resolve();
      const l = document.createElement('link');
      l.rel = 'stylesheet';
      l.href = href;
      l.onload = resolve;
      l.onerror = reject;
      document.head.appendChild(l);
    });
  }

  async function initStockTable() {
    await loadCss(DT_CSS);
    if (typeof window.jQuery === 'undefined') await loadScript(JQ);
    const $ = window.jQuery;
    if (!$.fn.DataTable) await loadScript(DT_JS);

    if ($.fn.DataTable.isDataTable('#stockTable')) {
      $('#stockTable').DataTable().destroy();
    }

    $('#stockTable').DataTable({
      responsive: true,
      order: [[1, 'asc']],
      columnDefs: [{ targets: 3, orderable: false, searchable: false }],
      language: {
        search: "",
        searchPlaceholder: "Search stock...",
        paginate: { previous: "← Prev", next: "Next →" }
      },
      pageLength: 10,
      initComplete: function() {
        const wrapper = $(this.api().table().container());
        const dtInput = wrapper.find('div.dataTables_filter input');
        dtInput.addClass(
          'bg-white text-gray-900 border border-gray-300 rounded-lg px-3 py-2 focus:outline-none ' +
          'focus:ring-2 focus:ring-blue-500 focus:border-blue-500 shadow-sm'
        ).attr('placeholder', '🔍 Search stock...');
        wrapper.find('.dataTables_filter').addClass('float-right mb-3');
      }
    });
  }

  initStockTable();
})();
</script>
