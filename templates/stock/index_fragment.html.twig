{# templates/stock/index_fragment.html.twig #}
{# This template contains ONLY the embeddable content for the Stock tab #}

<div class="flex justify-end mb-4">
    <a href="{{ path('app_stock_new') }}" class="bg-blue-600 text-white px-4 py-2 rounded-lg shadow-md hover:bg-blue-700 font-semibold transition duration-150">
        ➕ Add New Stock
    </a>
</div>

{# The table is now cleaner, inheriting global DataTables styles #}
<div class="overflow-x-auto">
    <table id="stockTable" class="min-w-full text-sm text-gray-700 divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="py-3 px-6 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                <th class="py-3 px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Product</th>
                <th class="py-3 px-6 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Quantity</th>
                <th class="py-3 px-6 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            {% for stock in stocks %}
                <tr class="hover:bg-gray-50 transition duration-100">
                    <td class="py-4 px-6 text-center whitespace-nowrap">{{ stock.id }}</td>
                    <td class="py-4 px-6 font-medium text-gray-900 text-left whitespace-nowrap">
                        {{ stock.product ? stock.product.name : '—' }}
                    </td>
                    <td class="py-4 px-6 font-bold text-blue-600 text-right whitespace-nowrap">{{ stock.quantity }}</td>
                    <td class="py-4 px-6 text-right whitespace-nowrap space-x-3">
                        <a href="{{ path('app_stock_show', {'id': stock.id}) }}" class="text-blue-500 hover:text-blue-700">View</a> 
                        <a href="{{ path('app_stock_edit', {'id': stock.id}) }}" class="text-green-600 hover:text-green-800">Edit</a>
                        <form method="post" action="{{ path('app_stock_delete', {'id': stock.id}) }}" class="inline-block" onsubmit="return confirm('Are you sure you want to delete this stock?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ stock.id) }}">
                            <button class="text-red-500 hover:text-red-700" type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center py-8 text-gray-400 italic">No stock records available yet.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{# Inline script for DataTables initialization (must be here to run after the table element is loaded) #}
<script>
    // Ensure the DataTables initialization is wrapped in a check to prevent errors if the script runs too early
    $(document).ready(function() {
        // Only initialize if the table element exists
        if ($.fn.DataTable.isDataTable('#stockTable')) {
            $('#stockTable').DataTable().destroy();
        }

        $('#stockTable').DataTable({
            responsive: true,
            order: [[1, 'asc']], 
            columnDefs: [
                { targets: 3, orderable: false, searchable: false }
            ],
            language: {
                paginate: {
                    previous: 'Prev',
                    next: 'Next'
                }
            }
        });
    });
</script>