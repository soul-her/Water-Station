{% extends 'base.html.twig' %}

{% block title %}📦 Stock Management | Touch Up{% endblock %}

{% block body %}
<main class="max-w-6xl mx-auto py-16 px-6">
    <div class="flex justify-between items-center mb-10">
        <h1 class="text-4xl font-extrabold primary-dark">📦 Stock Management</h1>
        <a href="{{ path('app_stock_new') }}" class="primary-accent text-white px-6 py-3 rounded-lg shadow-md primary-accent-hover font-semibold">
            ➕ Add New Stock
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-lg overflow-hidden border-t-4 border-blue-500">
        <table class="min-w-full text-sm text-gray-700">
            <thead class="bg-blue-50 text-gray-800 uppercase text-xs font-semibold">
                <tr>
                    <th class="py-4 px-6">ID</th>
                    <th class="py-4 px-6">Product</th>
                    <th class="py-4 px-6">Quantity</th>
                    <th class="py-4 px-6 text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for stock in stocks %}
                    <tr class="border-b hover:bg-gray-50 transition">
                        <td class="py-4 px-6">{{ stock.id }}</td>
                        <td class="py-4 px-6 font-medium text-gray-900">
                            {{ stock.product ? stock.product.name : '—' }}
                        </td>
                        <td class="py-4 px-6 font-bold text-blue-600">{{ stock.quantity }}</td>
                        <td class="py-4 px-6 text-right">
                            <a href="{{ path('app_stock_show', {'id': stock.id}) }}" class="text-blue-500 hover:underline">View</a> |
                            <a href="{{ path('app_stock_edit', {'id': stock.id}) }}" class="text-green-600 hover:underline">Edit</a>
                            <form method="post" action="{{ path('app_stock_delete', {'id': stock.id}) }}" class="inline" onsubmit="return confirm('Are you sure you want to delete this stock?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ stock.id) }}">
                                <button class="text-red-500 hover:underline ml-2" type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center py-8 text-gray-400 italic">No stock records available yet.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</main>
{% endblock %}
