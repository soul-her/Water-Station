<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>📦 Stock Management | Touch Up</title>
    
    <link rel="stylesheet" href="{{ asset('build/app.css') }}">
    
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/2.0.8/css/dataTables.tailwindcss.css">
    
    <style>
        /*
         * Custom Tailwind styles for DataTables controls
         * DataTables uses older classes that need to be styled to match Tailwind
         */
        .dataTables_wrapper .dataTables_filter label,
        .dataTables_wrapper .dataTables_length label,
        .dataTables_wrapper .dataTables_info {
            @apply text-sm text-gray-700;
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button {
            @apply p-2 rounded-lg transition duration-150 ease-in-out;
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button.current {
            @apply bg-blue-500 text-white shadow-md; /* Using blue accent color */
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button.disabled {
            @apply text-gray-400 cursor-not-allowed;
        }
        /* Fix for input fields */
        .dataTables_wrapper input[type="search"],
        .dataTables_wrapper select {
            @apply shadow-sm focus:ring-blue-500 focus:border-blue-500 block sm:text-sm border-gray-300 rounded-md;
        }

        /* Custom colors referenced in your HTML (assuming these map to Tailwind utility classes) */
        .primary-dark { color: #1f2937; } /* Example: gray-800 */
        .primary-accent { background-color: #3b82f6; } /* Example: blue-500 */
        .primary-accent-hover:hover { background-color: #2563eb; } /* Example: blue-600 */
    </style>
</head>
<body class="bg-gray-100">
    
    <main class="max-w-6xl mx-auto py-16 px-6">
        <div class="flex justify-between items-center mb-10">
            <h1 class="text-4xl font-extrabold primary-dark">📦 Stock Management</h1>
            <a href="{{ path('app_stock_new') }}" class="primary-accent text-white px-6 py-3 rounded-lg shadow-md primary-accent-hover font-semibold">
                ➕ Add New Stock
            </a>
        </div>

        <div class="bg-white rounded-2xl shadow-lg overflow-hidden border-t-4 border-blue-500 p-4">
            <table id="stockTable" class="min-w-full text-sm text-gray-700">
                <thead class="bg-blue-50 text-gray-800 uppercase text-xs font-semibold">
                    <tr>
                        <th class="py-4 px-6 text-center">ID</th>
                        <th class="py-4 px-6 text-left">Product</th>
                        <th class="py-4 px-6 text-right">Quantity</th>
                        <th class="py-4 px-6 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for stock in stocks %}
                        <tr class="border-b hover:bg-gray-50 transition">
                            <td class="py-4 px-6 text-center">{{ stock.id }}</td>
                            <td class="py-4 px-6 font-medium text-gray-900 text-left">
                                {{ stock.product ? stock.product.name : '—' }}
                            </td>
                            <td class="py-4 px-6 font-bold text-blue-600 text-right">{{ stock.quantity }}</td>
                            <td class="py-4 px-6 text-right whitespace-nowrap">
                                <a href="{{ path('app_stock_show', {'id': stock.id}) }}" class="text-blue-500 hover:underline">View</a> |
                                <a href="{{ path('app_stock_edit', {'id': stock.id}) }}" class="text-green-600 hover:underline">Edit</a>
                                <form method="post" action="{{ path('app_stock_delete', {'id': stock.id}) }}" class="inline" onsubmit="return confirm('Are you sure you want to delete this stock?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ stock.id) }}">
                                    <button class="text-red-500 hover:underline ml-2" type="submit">Delete</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center py-8 text-gray-400 italic">No stock records available yet.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </main>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawR/Y2/232m/N/A6kzX24B51jW53/3yA6Wq0=" crossorigin="anonymous"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.tailwindcss.js"></script>

    <script>
        $(document).ready(function() {
            // Initialize DataTables on the target table ID
            $('#stockTable').DataTable({
                responsive: true,
                order: [[1, 'asc']], // Sort by 'Product' column by default (column index 1)
                columnDefs: [
                    // Disable sorting/searching on the 'Actions' column (index 3)
                    { targets: 3, orderable: false, searchable: false }
                ],
                // Customize pagination text for a cleaner look
                language: {
                    paginate: {
                        previous: 'Prev',
                        next: 'Next'
                    }
                }
            });
        });
    </script>
</body>
</html>