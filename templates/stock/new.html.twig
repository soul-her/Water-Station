<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>➕ Add Stock | Touch Up</title>

    {# ✅ Tailwind CSS CDN #}
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        /* Optional: custom accent color for consistency */
        .primary-accent {
            background-color: #2563eb; /* blue-600 */
        }
        .primary-accent-hover:hover {
            background-color: #1e40af; /* blue-800 */
        }
    </style>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center">

    <main class="max-w-lg w-full mx-auto py-16 px-6">
        <div class="bg-white shadow-lg rounded-2xl p-8 border-t-4 border-blue-500">
            <h1 class="text-3xl font-bold mb-6 text-center text-gray-800">➕ Add New Stock</h1>

            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                <div>
                    {{ form_label(form.product, 'Product', {'label_attr': {'class': 'block text-gray-700 font-medium mb-2'}}) }}
                    {{ form_widget(form.product, {'attr': {'class': 'w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-blue-400 focus:outline-none'}}) }}
                </div>

                <div>
                    {{ form_label(form.quantity, 'Quantity', {'label_attr': {'class': 'block text-gray-700 font-medium mb-2'}}) }}
                    {{ form_widget(form.quantity, {'attr': {'class': 'w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-blue-400 focus:outline-none'}}) }}
                </div>

                <div class="text-center">
                    <button class="primary-accent text-white font-semibold px-6 py-3 rounded-lg shadow-md primary-accent-hover transition">
                        Save Stock
                    </button>
                </div>
            {{ form_end(form) }}

           
            </div>
        </div>
    </main>

</body>
</html>
