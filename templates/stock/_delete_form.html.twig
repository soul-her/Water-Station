<form method="post" 
      action="{{ path('app_stock_delete', {'id': stock.id}) }}" 
      onsubmit="return confirmDelete(event)">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ stock.id) }}">
    <button type="submit" 
            class="bg-red-600 text-white px-5 py-2 rounded-lg shadow hover:bg-red-700 transition font-medium">
        🗑️ Delete
    </button>
</form>

<script>
function confirmDelete(event) {
    if (!confirm('⚠️ Are you sure you want to delete this stock record? This action cannot be undone.')) {
        event.preventDefault();
    }
}
</script>
