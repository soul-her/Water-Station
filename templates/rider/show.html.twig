{% extends 'base.html.twig' %}

{% block title %}Rider{% endblock %}

{% block body %}
    <h1>Rider</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ rider.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ rider.name }}</td>
            </tr>
            <tr>
                <th>Phone</th>
                <td>{{ rider.phone }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ rider.status }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_rider_index') }}">back to list</a>

    <a href="{{ path('app_rider_edit', {'id': rider.id}) }}">edit</a>

    {{ include('rider/_delete_form.html.twig') }}
{% endblock %}
