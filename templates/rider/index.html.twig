{% extends 'base.html.twig' %}

{% block title %}Rider index{% endblock %}

{% block body %}
    <h1>Rider index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Phone</th>
                <th>Status</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for rider in riders %}
            <tr>
                <td>{{ rider.id }}</td>
                <td>{{ rider.name }}</td>
                <td>{{ rider.phone }}</td>
                <td>{{ rider.status }}</td>
                <td>
                    <a href="{{ path('app_rider_show', {'id': rider.id}) }}">show</a>
                    <a href="{{ path('app_rider_edit', {'id': rider.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_rider_new') }}">Create new</a>
{% endblock %}
