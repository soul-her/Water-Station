{# templates/category/index_fragment.html.twig #}
{# Designed to be embedded (rendered) within the Admin Dashboard content block #}

<div class="p-0">
    <div class="flex justify-between items-center mb-6">
        {# Changed H1 to H2 to fit dashboard hierarchy #}
        <h2 class="text-2xl font-semibold text-gray-800">Categories</h2>
        <a href="{{ path('app_category_new') }}" 
            class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition shadow-md font-medium">
            ➕ Create New
        </a>
    </div>

    <div class="rounded-xl border border-gray-200 overflow-hidden">
        <table id="categoryTable" class="min-w-full text-sm text-gray-700 divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    {# NOTE: The blue header background (bg-blue-600) was moved to global styles if desired, otherwise use bg-gray-50 for a cleaner look #}
                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                {% for category in categories %}
                    <tr class="hover:bg-gray-50 transition">
                        <td class="px-6 py-3 text-gray-700 text-center">{{ category.id }}</td>
                        <td class="px-6 py-3 text-gray-900 font-medium text-left">{{ category.name }}</td>
                        <td class="px-6 py-3 text-right whitespace-nowrap space-x-3">
                            <a href="{{ path('app_category_show', {'id': category.id}) }}" 
                                class="text-blue-600 hover:text-blue-800 font-medium">View</a>
                            <a href="{{ path('app_category_edit', {'id': category.id}) }}" 
                                class="text-green-600 hover:text-green-800 font-medium">Edit</a>
                            
                            {# Include Delete Form Fragment here #}
                            {# Assumes you have a category/_delete_form.html.twig fragment #}
                            <form method="post" action="{{ path('app_category_delete', {'id': category.id}) }}" class="inline-block" onsubmit="return confirm('Are you sure you want to delete category {{ category.name }}?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
                                <button type="submit" class="text-red-500 hover:text-red-700 font-medium">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-center py-6 text-gray-400 italic">No categories found.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# DataTables initialization script (must be here to run after the table is in the DOM) #}
<script>
    $(document).ready(function() {
        // Destroy existing DataTables instance if it exists
        if ($.fn.DataTable.isDataTable('#categoryTable')) {
            $('#categoryTable').DataTable().destroy();
        }
        
        $('#categoryTable').DataTable({
            responsive: true,
            order: [[1, 'asc']], // Sort by 'Name' column by default (column index 1)
            columnDefs: [
                // Disable sorting/searching on the 'Actions' column (index 2)
                { targets: 2, orderable: false, searchable: false }
            ],
            language: {
                paginate: {
                    previous: 'Prev',
                    next: 'Next'
                }
            }
        });
    });
</script>