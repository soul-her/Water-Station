{# templates/category/index_fragment.html.twig #}
<div class="p-0">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-semibold text-gray-800">Categories</h2>
        <a href="{{ path('app_category_new') }}" 
            class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition shadow-md font-medium">
            ➕ Create New
        </a>
    </div>

    <div class="rounded-xl border border-gray-200 overflow-hidden">
        <table id="categoryTable" class="min-w-full text-sm text-gray-700 divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                {% for category in categories %}
                    <tr class="hover:bg-gray-50 transition">
                        <td class="px-6 py-3 text-gray-700 text-center">{{ category.id }}</td>
                        <td class="px-6 py-3 text-gray-900 font-medium text-left">{{ category.name }}</td>
                        <td class="px-6 py-3 text-right whitespace-nowrap space-x-3">
                            <a href="{{ path('app_category_show', {'id': category.id}) }}" 
                                class="text-blue-600 hover:text-blue-800 font-medium">View</a>
                            <a href="{{ path('app_category_edit', {'id': category.id}) }}" 
                                class="text-green-600 hover:text-green-800 font-medium">Edit</a>

                            <form method="post" action="{{ path('app_category_delete', {'id': category.id}) }}" 
                                  class="inline-block" 
                                  onsubmit="return confirm('Are you sure you want to delete category {{ category.name }}?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
                                <button type="submit" class="text-red-500 hover:text-red-700 font-medium">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-center py-6 text-gray-400 italic">No categories found.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{# Inline styling for white search + nicer selects/pagination #}
<style>
/* Base styling for DataTables controls (will be applied after DataTables renders) */
div.dataTables_wrapper .dataTables_filter input {
  background-color: white !important;
  color: #1f2937 !important;
  border: 1px solid #d1d5db !important;
  border-radius: 0.5rem !important;
  padding: 0.5rem 1rem !important;
  outline: none !important;
  transition: box-shadow 0.15s ease-in-out;
}
div.dataTables_wrapper .dataTables_filter input:focus {
  box-shadow: 0 0 0 3px rgba(37,99,235,0.12) !important;
}
div.dataTables_wrapper .dataTables_length select {
  background-color: white !important;
  border: 1px solid #d1d5db !important;
  border-radius: 0.5rem !important;
  padding: 0.25rem 0.5rem !important;
}
div.dataTables_wrapper .dataTables_paginate a {
  background-color: white;
  border: 1px solid #e5e7eb;
  border-radius: 0.375rem;
  padding: 0.25rem 0.5rem;
  margin-left: 0.25rem;
  margin-right: 0.25rem;
}
div.dataTables_wrapper .dataTables_paginate a.current {
  background-color: #2563eb;
  color: white;
  border-color: #2563eb;
}
</style>

<script>
/*
  Robust initialization:
  - loads jQuery/DataTables if missing (CDN)
  - waits until scripts available
  - initializes DataTable with initComplete callback to style controls AFTER render
*/
(function () {
  const JQUERY_CDN = 'https://code.jquery.com/jquery-3.7.1.min.js';
  const DATATABLES_JS = 'https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js';
  const DATATABLES_RESPONSIVE_JS = 'https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js';
  const DATATABLES_CSS = 'https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css';
  const DATATABLES_RESP_CSS = 'https://cdn.datatables.net/responsive/2.5.0/css/responsive.dataTables.min.css';

  function loadScript(src) {
    return new Promise((resolve, reject) => {
      // already present?
      if (document.querySelector('script[src="' + src + '"]')) return resolve();
      const s = document.createElement('script');
      s.src = src;
      s.async = false;
      s.onload = resolve;
      s.onerror = reject;
      document.head.appendChild(s);
    });
  }
  function loadCss(href) {
    return new Promise((resolve, reject) => {
      if (document.querySelector('link[href="' + href + '"]')) return resolve();
      const l = document.createElement('link');
      l.rel = 'stylesheet';
      l.href = href;
      l.onload = resolve;
      l.onerror = reject;
      document.head.appendChild(l);
    });
  }

  async function ensureDependencies() {
    // load CSS first so layout is correct
    await Promise.all([loadCss(DATATABLES_CSS), loadCss(DATATABLES_RESP_CSS)]);

    if (typeof window.jQuery === 'undefined') {
      await loadScript(JQUERY_CDN);
    }
    if (typeof window.jQuery === 'undefined') {
      throw new Error('jQuery failed to load');
    }
    // Now load DataTables JS
    if (!window.jQuery.fn || !window.jQuery.fn.DataTable) {
      await loadScript(DATATABLES_JS);
      await loadScript(DATATABLES_RESPONSIVE_JS);
    }
  }

  function initTable() {
    const $ = window.jQuery;
    // Safety: if table not present, abort
    if (!$('#categoryTable').length) return;

    // Destroy previous instance if any (useful when re-rendering fragments)
    if ($.fn.DataTable.isDataTable('#categoryTable')) {
      $('#categoryTable').DataTable().destroy();
    }

    $('#categoryTable').DataTable({
      responsive: true,
      order: [[1, 'asc']],
      columnDefs: [{ targets: 2, orderable: false, searchable: false }],
      language: {
        search: "",
        searchPlaceholder: "🔍Search categories...",
        paginate: { previous: 'Prev', next: 'Next' }
      },
      pageLength: 10,
      initComplete: function () {
        const wrapper = $(this.api().table().container());

        // Apply classes to search input and select (Tailwind-like)
        const dtInput = wrapper.find('div.dataTables_filter input');
        dtInput.addClass(
          'bg-white text-gray-900 border border-gray-300 rounded-lg px-3 py-2 ' +
          'focus:outline-none'
        );
        // move label to the right for layout (optional)
        wrapper.find('.dataTables_filter').addClass('flex justify-end mb-3');

        // style length select
        wrapper.find('div.dataTables_length select').addClass('bg-white border border-gray-300 rounded px-2 py-1');

        // style pagination anchors
        const pag = wrapper.find('div.dataTables_paginate a');
        pag.addClass('inline-block px-2 py-1 rounded-md');
        wrapper.find('div.dataTables_paginate a.current').addClass('bg-blue-600 text-white');

        // small accessibility: ensure placeholder present
        if (!dtInput.attr('placeholder') || dtInput.attr('placeholder').trim() === '') {
          dtInput.attr('placeholder', '  Search categories...');
        }
      }
    });
  }

  // kick off
  ensureDependencies()
    .then(initTable)
    .catch((err) => {
      // show minimal console error but don't break the page
      console.error('DataTables init failed:', err);
    });
})();
</script>
