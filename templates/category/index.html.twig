{% extends 'base.html.twig' %}

{% block title %}Categories{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <!-- DataTables CSS for Tailwind -->
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/2.0.8/css/dataTables.tailwindcss.css">
    <style>
        /*
         * Custom Tailwind styles for DataTables controls
         * DataTables uses older classes that need to be styled to match Tailwind
         */
        .dataTables_wrapper .dataTables_filter label,
        .dataTables_wrapper .dataTables_length label,
        .dataTables_wrapper .dataTables_info {
            @apply text-sm text-gray-700;
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button {
            @apply p-2 rounded-lg transition duration-150 ease-in-out;
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button.current {
            @apply bg-blue-600 text-white shadow-md; /* Using blue accent color */
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button.disabled {
            @apply text-gray-400 cursor-not-allowed;
        }
        /* Fix for input fields */
        .dataTables_wrapper input[type="search"],
        .dataTables_wrapper select {
            @apply shadow-sm focus:ring-blue-600 focus:border-blue-600 block sm:text-sm border-gray-300 rounded-md;
        }
        /* Added padding for DataTables controls */
        .dataTables_wrapper {
            @apply p-4;
        }
    </style>
{% endblock %}

{% block body %}
<main class="max-w-5xl mx-auto mt-16 bg-white p-8 rounded-2xl shadow-lg">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-800">📂 Categories</h1>
        <a href="{{ path('app_category_new') }}" 
            class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition shadow-md">
            ➕ Create New
        </a>
    </div>

    <!-- DataTables wrapper container -->
    <div class="rounded-xl border border-gray-200 overflow-hidden">
        <!-- CRITICAL: Added id="categoryTable" for DataTables initialization -->
        <table id="categoryTable" class="min-w-full text-sm text-gray-700">
            <thead class="bg-blue-600 text-white">
                <tr>
                    <!-- ALIGNMENT: Center ID for numeric data -->
                    <th class="px-6 py-3 text-center text-sm font-medium">ID</th>
                    <!-- ALIGNMENT: Left Align Name for text data -->
                    <th class="px-6 py-3 text-left text-sm font-medium">Name</th>
                    <!-- ALIGNMENT: Right Align Actions -->
                    <th class="px-6 py-3 text-right text-sm font-medium">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
                {% for category in categories %}
                    <tr class="hover:bg-gray-50 transition">
                        <!-- ALIGNMENT: Center ID -->
                        <td class="px-6 py-3 text-gray-700 text-center">{{ category.id }}</td>
                        <!-- ALIGNMENT: Left Align Name -->
                        <td class="px-6 py-3 text-gray-900 font-medium text-left">{{ category.name }}</td>
                        <!-- ALIGNMENT: Right Align Actions -->
                        <td class="px-6 py-3 text-right whitespace-nowrap">
                            <a href="{{ path('app_category_show', {'id': category.id}) }}" 
                                class="text-blue-600 hover:underline mr-4">View</a>
                            <a href="{{ path('app_category_edit', {'id': category.id}) }}" 
                                class="text-green-600 hover:underline">Edit</a>
                        </td>
                    </tr>
                {% else %}
                    <!-- This row will be hidden once DataTables is initialized -->
                    <tr>
                        <td colspan="3" class="text-center py-6 text-gray-500">No categories found.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <!-- jQuery (required for DataTables) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawR/Y2/232m/N/A6kzX24B51jW53/3yA6Wq0=" crossorigin="anonymous"></script>
    <!-- DataTables Core JS -->
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <!-- DataTables Tailwind Integration JS (Must be after core) -->
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.tailwindcss.js"></script>

    <script>
        $(document).ready(function() {
            // Initialize DataTables on the target table ID
            $('#categoryTable').DataTable({
                responsive: true,
                order: [[1, 'asc']], // Sort by 'Name' column by default (column index 1)
                columnDefs: [
                    // Disable sorting/searching on the 'Actions' column (index 2)
                    { targets: 2, orderable: false, searchable: false }
                ],
                // Customize pagination text for a cleaner look
                language: {
                    paginate: {
                        previous: 'Prev',
                        next: 'Next'
                    }
                }
            });
        });
    </script>
{% endblock %}
