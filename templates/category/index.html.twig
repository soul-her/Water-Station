{% extends 'base.html.twig' %}

{% block title %}Categories{% endblock %}

{% block body %}
<main class="max-w-5xl mx-auto mt-16 bg-white p-8 rounded-2xl shadow-lg">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-800">📂 Categories</h1>
        <a href="{{ path('app_category_new') }}" 
           class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">
            ➕ Create New
        </a>
    </div>

    <div class="overflow-x-auto">
        <table class="min-w-full border border-gray-200 rounded-lg overflow-hidden">
            <thead class="bg-blue-600 text-white">
                <tr>
                    <th class="px-6 py-3 text-left text-sm font-medium">ID</th>
                    <th class="px-6 py-3 text-left text-sm font-medium">Name</th>
                    <th class="px-6 py-3 text-left text-sm font-medium">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
                {% for category in categories %}
                    <tr class="hover:bg-gray-100 transition">
                        <td class="px-6 py-3 text-gray-700">{{ category.id }}</td>
                        <td class="px-6 py-3 text-gray-900 font-medium">{{ category.name }}</td>
                        <td class="px-6 py-3">
                            <a href="{{ path('app_category_show', {'id': category.id}) }}" 
                               class="text-blue-600 hover:underline mr-4">View</a>
                            <a href="{{ path('app_category_edit', {'id': category.id}) }}" 
                               class="text-green-600 hover:underline">Edit</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-center py-6 text-gray-500">No categories found.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</main>
{% endblock %}
