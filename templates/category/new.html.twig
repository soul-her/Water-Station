{% extends 'base.html.twig' %}

{% block title %}Create Category{% endblock %}

{% block body %}
<main class="max-w-3xl mx-auto mt-20 bg-white p-8 rounded-2xl shadow-lg">
    <h1 class="text-3xl font-bold mb-6 text-gray-800">➕ Create New Category</h1>

    {{ form_start(form) }}
        <div class="mb-4">
            {{ form_label(form.name, 'Category Name', {'label_attr': {'class': 'block text-gray-700 font-medium mb-2'}}) }}
            {{ form_widget(form.name, {'attr': {'class': 'w-full border-gray-300 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500'}}) }}
            {{ form_errors(form.name) }}
        </div>

        <button type="submit" 
                class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition">
            Save
        </button>
    {{ form_end(form) }}

    <a href="{{ path('app_category_index') }}" 
       class="inline-block mt-6 text-gray-600 hover:underline">
        ← Back to list
    </a>
</main>
{% endblock %}
