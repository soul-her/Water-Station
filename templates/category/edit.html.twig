<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Category</title>

    {# Include Tailwind CSS CDN #}
    <script src="https://cdn.tailwindcss.com"></script>

    {# Optional: include your favicon or custom styles here #}
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center">

    <main class="max-w-3xl mx-auto mt-20 bg-white p-8 rounded-2xl shadow-lg w-full">
        <h1 class="text-3xl font-bold mb-6 text-gray-800">✏️ Edit Category</h1>

        {{ form_start(form) }}
            <div class="mb-4">
                {{ form_label(form.name, 'Category Name', {
                    'label_attr': {'class': 'block text-gray-700 font-medium mb-2'}
                }) }}
                {{ form_widget(form.name, {
                    'attr': {
                        'class': 'w-full border-gray-300 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500'
                    }
                }) }}
                {{ form_errors(form.name) }}
            </div>

            <button type="submit" 
                    class="bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700 transition">
                Update
            </button>
        {{ form_end(form) }}

        <div class="mt-6 flex justify-between">
            <a href="{{ path('app_category_index') }}" class="text-gray-600 hover:underline">← Back</a>
            {{ include('category/_delete_form.html.twig') }}
        </div>
    </main>

</body>
</html>
