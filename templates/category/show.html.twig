{% extends 'base.html.twig' %}

{% block title %}View Category{% endblock %}

{% block body %}
<main class="max-w-3xl mx-auto mt-20 bg-white p-8 rounded-2xl shadow-lg">
    <h1 class="text-3xl font-bold mb-6 text-gray-800">📁 Category Details</h1>

    <div class="space-y-4 text-lg text-gray-700">
        <p><strong>ID:</strong> {{ category.id }}</p>
        <p><strong>Name:</strong> {{ category.name }}</p>
    </div>

    <div class="mt-8 flex justify-between">
        <a href="{{ path('app_category_index') }}" 
           class="bg-gray-200 text-gray-800 px-4 py-2 rounded-lg hover:bg-gray-300 transition">
           ← Back to list
        </a>

        <a href="{{ path('app_category_edit', {'id': category.id}) }}" 
           class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">
           ✏️ Edit
        </a>
    </div>

    {{ include('category/_delete_form.html.twig') }}
</main>
{% endblock %}
